# ============================================================
# Supabase
# Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used by trusted server-side jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Headless WordPress (Creatordock)
# ============================================================
WORDPRESS_API_URL=https://creatordock.online/wp-json/wp/v2
NEXT_PUBLIC_WORDPRESS_SITE_URL=https://creatordock.online
# Optional: only needed if the REST API is protected.
WORDPRESS_API_TOKEN=

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CreatorChat
